{
  "name": "persoatlas",
  "version": "1.0.0",
  "description": "A local-first, game-like atlas for any learning journey: skills, projects, roadmap, knowledge atlas, focus log, journal and profile, offline in one HTML file.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run packs && vite",
    "build": "npm run packs && vite build",
    "preview": "vite preview",
    "packs": "node scripts/build-packs.mjs",
    "validate": "node scripts/build-packs.mjs --check",
    "lint": "eslint .",
    "test": "npm run packs && vitest run",
    "test:e2e": "npm run build && playwright test",
    "screenshots": "npm run build && SCREENSHOTS=1 playwright test screenshots",
    "check": "npm run lint && npm run validate && npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@fontsource/chakra-petch": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@playwright/test": "^1.53.1",
    "ajv": "^8.17.1",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.0"
  },
  "keywords": [
    "learning",
    "self-study",
    "roadmap",
    "gamification",
    "local-first",
    "offline",
    "study-planner",
    "skill-tree",
    "knowledge-management",
    "productivity"
  ]
}
